# 복사해서 .env 로 쓰세요. 실제 값은 커밋하지 않습니다.
# 백엔드 (backend/.env)
MODEL_PATH=
CORS_ORIGINS=["http://localhost:3000"]
# 예: postgresql://사용자:비밀번호@호스트:5432/DB이름?sslmode=require  (Azure는 sslmode=require 필수)
DATABASE_URL=
# 임시 원본 보관 Blob. 비워 두면 로컬 임시 폴더를 쓴다. 접속은 관리 ID(로컬은 az login)로 한다.
# 예: https://<계정>.blob.core.windows.net
BLOB_ACCOUNT_URL=
BLOB_CONTAINER=temp-originals
# 휴대폰 앱으로 개발 서버를 볼 때만 (같은 Wi-Fi 의 사설 IP 허용)
# CORS_ORIGIN_REGEX=http://(192\.168|10|172\.(1[6-9]|2[0-9]|3[01]))\.[0-9.]+:3000

# 프론트엔드 (frontend/.env.local)
# 비워 두면 페이지를 연 호스트의 :8000 을 쓴다 (휴대폰 앱 개발 시 편함)
NEXT_PUBLIC_API_BASE_URL=

# 모바일 앱 (mobile/.env) — 비워 두면 Expo 개발 서버와 같은 PC의 :3000 을 띄운다
EXPO_PUBLIC_WEB_URL=
