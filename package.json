{
  "name": "ax-monorepo",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "turbo run dev --filter frontend",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write frontend mobile packages",
    "check:js": "turbo run lint typecheck test build",
    "check:py": "uv run ruff check . && uv run ruff format --check . && uv run pytest -q && uv run python -m app.export_openapi --check",
    "check": "pnpm check:js && pnpm check:py"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "turbo": "^2.11.11"
  }
}
